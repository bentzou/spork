# Workspace justfile — imports spork's shared recipes and adds anything
# workspace-specific. The shared recipes live in `.spork/spork.just` and update
# when you pull the spork repo; keep your own recipes and overrides below.
#
# `set allow-duplicate-recipes` lets a recipe here override an imported one of
# the same name (used by the commented example below).

set shell := ["bash", "-uc"]
set allow-duplicate-recipes := true

import '.spork/spork.just'

# Bare `just` lists recipes in source order.
[private]
default:
    @just --list --unsorted

# --- Workspace-specific recipes / overrides go below ---
#
# Example: if your app lives in a monorepo subdir, override agent launchers/go
# to target it (everything else is inherited from .spork/spork.just):
#
# [group('use')]
# [positional-arguments]
# claude *args:
#     @owner=$$; rel="$PWD/.spork/tools/release.sh"; \
#      case " $* " in *" -"*) ;; *) [ $# -gt 1 ] && set -- "$*";; esac; \
#      path=$(./.spork/tools/claim.sh "$owner" claude) || exit 1; \
#      trap 'bash "$rel" "$path" "$owner"' EXIT; \
#      cd "$path/SUBDIR" && claude "$@"
#
# [group('use')]
# [positional-arguments]
# codex *args:
#     @owner=$$; rel="$PWD/.spork/tools/release.sh"; \
#      case " $* " in *" -"*) ;; *) [ $# -gt 1 ] && set -- "$*";; esac; \
#      path=$(./.spork/tools/claim.sh "$owner" codex) || exit 1; \
#      trap 'bash "$rel" "$path" "$owner"' EXIT; \
#      cd "$path/SUBDIR" && codex "$@"
#
# [group('use')]
# go:
#     @path=$(./.spork/tools/pick-ready.sh) && echo "$path/SUBDIR"
