# spork recipes — copy into your workspace's justfile (or merge with existing).
# Assumes spork tools are reachable at .spork/tools/. If you symlink the
# spork repo's tools/ in (recommended), the paths below work as-is.

# One-line status per clone (ready / branch work / local changes / needs pull).
status:
    @./.spork/tools/status-all.sh

# Pull trunk in every clone. Skips non-trunk branches and dirty trees.
pull:
    @./.spork/tools/pull-all.sh

# Fetch every clone (no merge, no skip rules).
fetch:
    @./.spork/tools/pull-all.sh --fetch-only

# One-time: create shared bare mirror and link each clone to it.
sync-setup:
    @./.spork/tools/setup-mirror.sh

# Status table + background fetch/pull via the shared mirror.
sync:
    @./.spork/tools/status-all.sh
    @( ./.spork/tools/sync-bg.sh </dev/null >/dev/null 2>&1 & ) </dev/null

# Create the next clone (highest existing $CLONE_PREFIX<N> + 1) using the local mirror.
setup-clone:
    @./.spork/tools/setup-clone.sh

# Print the path of the first ready clone (use a shell wrapper to actually cd there).
go:
    @./.spork/tools/pick-ready.sh
