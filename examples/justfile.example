# Workspace justfile — imports spork's shared recipes and adds anything
# workspace-specific. The shared recipes live in `.spork/spork.just` and update
# when you pull the spork repo; keep your own recipes and overrides below.
#
# `set allow-duplicate-recipes` lets a recipe here override an imported one of
# the same name (used by the commented example below).

set shell := ["bash", "-uc"]
set allow-duplicate-recipes := true

import '.spork/spork.just'

# Bare `just` lists recipes in source order.
[private]
default:
    @just --list --unsorted

# --- Workspace-specific recipes / overrides go below ---
#
# Monorepo whose app lives in a subdir? Set CLONE_SUBDIR in
# .spork.local/config instead of overriding recipes here — the launchers and
# `just next` honor it, and a recipe defined in this file would jump ahead of
# the imported ones in the `just` menu.
