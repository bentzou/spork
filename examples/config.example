# spork workspace config — copy to <workspace>/.spork/config and edit.
#
# ORIGIN_URL: only directories whose remote.origin.url matches this are
#             treated as clones in this workspace.
# TRUNK_BRANCH: branch name that triggers ff-merge in `just sync`. Any other
#               branch is left alone (fetch-only).
# CLONE_PREFIX: prefix `clone` uses when picking the next clone name
#               (e.g. `p` -> p1, p2, ... ; `clone-` -> clone-1, clone-2, ...).
# POST_CLONE:   optional bash command run inside each new clone after
#               `clone` finishes the trunk checkout. Empty/unset = skip.
#               Examples:
#                 POST_CLONE='bun install'
#                 POST_CLONE='pnpm install && pnpm run prepare'
#                 POST_CLONE=./scripts/setup-new-clone.sh
# CLONE_SUBDIR: optional clone-relative dir sessions should start in — for
#               monorepos where the app lives below the repo root. `just
#               claude`/`codex` cd there and `just next` prints it; the pool
#               still claims and manages whole clones.
#               Example: CLONE_SUBDIR=src/my-app
# SPORK_AGENTS: optional, space-separated agent backends whose sessions spork
#               scans and can resume. Default: "claude codex".
# SPORK_LIVE_COMMANDS: optional, space-separated process names whose cwd
#               marks a clone as occupied ("in use"). Default:
#               "claude codex zsh bash fish" — add your shell if it's not
#               listed (e.g. SPORK_LIVE_COMMANDS='claude codex zsh bash fish nu').

ORIGIN_URL=git@github.com:YOUR-ORG/YOUR-REPO.git
TRUNK_BRANCH=main
CLONE_PREFIX=p
POST_CLONE=
